[Unit]
Description=LoreVia Docker Compose Stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/lorevia/current
ExecStart=/bin/bash -lc 'set -a; source /opt/lorevia/current/backend/.env; set +a; /usr/bin/docker compose -f docker-compose.yml up -d'
ExecStop=/bin/bash -lc 'set -a; source /opt/lorevia/current/backend/.env; set +a; /usr/bin/docker compose -f docker-compose.yml down'
TimeoutStartSec=0
Restart=no

[Install]
WantedBy=multi-user.target
