[Unit]
Description=LoreVia Docker Compose Stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/lorevia/current
EnvironmentFile=./backend/.env
ExecStart=/usr/bin/docker compose --env-file ./backend/.env -f docker-compose.yml up -d
ExecStop=/usr/bin/docker compose --env-file ./backend/.env -f docker-compose.yml down
TimeoutStartSec=0
Restart=no

[Install]
WantedBy=multi-user.target
