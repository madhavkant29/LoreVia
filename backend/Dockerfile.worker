FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Pre-download tiktoken encoding to avoid runtime network issues
# Matches default OPENAI_ENCODING_MODEL in config.py
RUN python -c "import tiktoken; tiktoken.encoding_for_model('gpt-4o-mini')"

COPY . .
# CMD overridden per Railway service:
# extraction: celery -A app.workers.celery_app worker -Q extraction -c 4
# analysis:   celery -A app.workers.celery_app worker -Q analysis,embedding -c 2
# intelligence: celery -A app.workers.celery_app worker -Q intelligence -c 1
CMD ["celery", "-A", "app.workers.celery_app", "worker", "-Q", "extraction,analysis,embedding", "--loglevel=info", "-c", "2"]
