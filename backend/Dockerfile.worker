FROM python:3.12-slim
WORKDIR /app
# Run Celery/Flower as non-root (required for production hygiene).
# Pre-create /app/storage with correct ownership so the named volume
# inherits permissions on first create.
RUN groupadd -g 10001 app && useradd -m -u 10001 -g 10001 -s /bin/bash app && \
    mkdir -p /app/storage && chown -R app:app /app
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Optional asset prefetch for network-permitted environments. The app falls
# back cleanly when the spaCy model is not present, so restricted builders
# should not fail just because external asset hosts are unreachable.
ARG PREFETCH_MODEL_ASSETS=0
RUN if [ "$PREFETCH_MODEL_ASSETS" = "1" ]; then \
        python -c "import tiktoken; tiktoken.encoding_for_model('gpt-4o-mini')" && \
        python -m spacy download en_core_web_sm; \
    fi

COPY backend/ .
RUN mkdir -p /frontend/src/lib/billing
COPY frontend/src/lib/billing/pricing-catalog.json /frontend/src/lib/billing/pricing-catalog.json
RUN chmod +x worker-start.sh
# Start as root so the entrypoint can normalize any mounted local-storage
# volume before dropping back to the non-root app user.
ENTRYPOINT ["./worker-start.sh"]
# CMD overridden per deployment service. Required workers in production:
#   worker-extraction:   celery -A app.workers.celery_app worker -n worker-extraction@%h -Q extraction,extraction_priority -c 4
#   worker-analysis:     celery -A app.workers.celery_app worker -n worker-analysis@%h -Q analysis,analysis_priority,embedding -c 2
#   worker-intelligence: celery -A app.workers.celery_app worker -n worker-intelligence@%h -Q intelligence -c 1
#   celery-beat:         celery -A app.workers.celery_app beat --loglevel=info
#
# Priority queues (extraction_priority, analysis_priority) are consumed by the
# same workers that handle standard queues so Architect-tier tasks run alongside
# standard tasks rather than accumulating in undrained queues.
CMD ["celery", "-A", "app.workers.celery_app", "worker", "-Q", "extraction,extraction_priority", "--loglevel=info", "-c", "4"]
